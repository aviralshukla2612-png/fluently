# =========================================================
# Shadowly Environment Configuration Guide
# =========================================================
#
# Production Rules:
# - AUTH_SECRET is REQUIRED in production (minimum 32 characters).
# - DATABASE_URL is REQUIRED in production for PostgreSQL persistence.
# - OLLAMA_* variables are optional (app uses curated fallbacks if offline).
# - Never prefix server secrets with NEXT_PUBLIC_.
#
# =========================================================
# 1. Authentication & Cryptography (REQUIRED IN PRODUCTION)
# =========================================================
# Strong 256-bit secret used for HMAC-SHA256 session and exercise tokens.
# Generate via: openssl rand -base64 32
AUTH_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# =========================================================
# 2. Database Persistence (REQUIRED IN PRODUCTION)
# =========================================================
# PostgreSQL connection string. In development/testing, falls back to in-memory store if unset.
# Local development example: postgresql://postgres:postgres@localhost:5432/shadowly?schema=public
# Cloud PostgreSQL example: postgresql://user:password@db.provider.com:5432/shadowly?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shadowly?schema=public

# =========================================================
# 3. AI Infrastructure (Local Ollama - Optional)
# =========================================================
# Base URL of the Ollama inference daemon
OLLAMA_BASE_URL=http://localhost:11434

# Primary conversational and coaching model
OLLAMA_MODEL=llama3.2:1b

# Request timeout in milliseconds (default: 15000)
OLLAMA_TIMEOUT_MS=15000

# =========================================================
# 4. Payment Gateway (Razorpay - Optional in dev, Required for live mock purchases)
# =========================================================
# Test mode Key ID from Razorpay Dashboard (starts with rzp_test_...)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Secret key (KEEP PRIVATE on server, never leak to client)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook signing secret configured in Razorpay Webhooks dashboard
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
